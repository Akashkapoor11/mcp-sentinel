{
  "name": "mcp-sentinel",
  "version": "1.1.0",
  "description": "A zero-dependency CLI smoke tester for MCP Streamable HTTP servers. Validates the 2025-11-25 protocol handshake, tool discovery, schema consistency, optional tool execution, and emits JSON or JUnit XML reports.",
  "keywords": ["mcp", "model-context-protocol", "streamable-http", "cli", "testing", "ai", "llm", "developer-tools"],
  "author": "FixRelay contributors",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "main": "dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./protocol": "./dist/protocol.js"
  },
  "bin": { "mcp-sentinel": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "CONTRIBUTING.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/cli.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
